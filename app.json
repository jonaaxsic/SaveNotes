{
  "expo": {
    "name": "SaveNotes",
    "slug": "SaveNotes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "savenotes",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.savenotes.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SaveNotes necesita acceso al micrófono para grabar tus notas de voz.",
        "NSSpeechRecognitionUsageDescription": "SaveNotes necesita reconocimiento de voz para transcribir tus notas."
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "SaveNotes necesita acceso al micrófono para grabar tus notas de voz.",
          "speechRecognitionPermission": "SaveNotes necesita reconocimiento de voz para transcribir tus notas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e418ee52-5559-4645-b3e8-a6605185e7f8"
      }
    },
    "owner": "jonaaxsic"
  }
}
